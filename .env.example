# Copy this file to .env and fill in your values for local Mac development.
# On the eisy these are set in the PG3 admin console under Configuration.
# .env is gitignored and never deployed.

# IP address of the OmniLogic/OmniPL controller on your LAN
OMNI_HOST=192.168.1.xxx

# UDP control port (default 10444 — only change if your setup differs)
# OMNI_PORT=10444

# Cloud rollback only (not used by the local protocol)
# HAYWARD_USERNAME=
# HAYWARD_PASSWORD=
